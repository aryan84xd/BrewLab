{
  "info": {
    "name": "BrewLab API",
    "description": "Coffee experiment tracking API with JWT authentication",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const response = pm.response.json();",
                  "    if (response.success && response.data.token) {",
                  "        pm.collectionVariables.set('token', response.data.token);",
                  "        pm.environment.set('token', response.data.token);",
                  "    }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test User\",\n  \"email\": \"test@example.com\",\n  \"password\": \"Test123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register"]
            },
            "description": "Register a new user account. Token is automatically saved."
          },
          "response": []
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const response = pm.response.json();",
                  "    if (response.success && response.data.token) {",
                  "        pm.collectionVariables.set('token', response.data.token);",
                  "        pm.environment.set('token', response.data.token);",
                  "    }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"test@brewlab.com\",\n  \"password\": \"Test123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            },
            "description": "Login with test credentials. Token is automatically saved.\n\nTest Credentials:\n- Email: test@brewlab.com\n- Password: Test123!"
          },
          "response": []
        },
        {
          "name": "Get Current User",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "me"]
            },
            "description": "Get current authenticated user information."
          },
          "response": []
        }
      ],
      "description": "Authentication endpoints for user registration and login"
    },
    {
      "name": "Coffees",
      "item": [
        {
          "name": "Get All Coffees",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/coffees",
              "host": ["{{baseUrl}}"],
              "path": ["api", "coffees"]
            },
            "description": "Get all coffees for the authenticated user."
          },
          "response": []
        },
        {
          "name": "Get Coffee by ID",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/coffees/22222222-2222-2222-2222-222222222222",
              "host": ["{{baseUrl}}"],
              "path": ["api", "coffees", "22222222-2222-2222-2222-222222222222"]
            },
            "description": "Get a specific coffee by ID. Returns 200 with success=false if not found."
          },
          "response": []
        },
        {
          "name": "Create Coffee",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ethiopian Yirgacheffe\",\n  \"brand\": \"Blue Bottle\",\n  \"roast\": \"Light\",\n  \"origin\": \"Ethiopia\",\n  \"tastingNotes\": \"Floral, citrus, tea-like\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/coffees",
              "host": ["{{baseUrl}}"],
              "path": ["api", "coffees"]
            },
            "description": "Create a new coffee entry."
          },
          "response": []
        }
      ],
      "description": "Coffee management endpoints"
    },
    {
      "name": "Experiments",
      "item": [
        {
          "name": "Get Experiments for Coffee",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/experiment/22222222-2222-2222-2222-222222222222",
              "host": ["{{baseUrl}}"],
              "path": ["api", "experiment", "22222222-2222-2222-2222-222222222222"]
            },
            "description": "Get all experiments for a specific coffee."
          },
          "response": []
        },
        {
          "name": "Create Experiment",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"coffeeId\": \"22222222-2222-2222-2222-222222222222\",\n  \"brewMethod\": \"V60\",\n  \"coffeeWeight\": 18.5,\n  \"waterWeight\": 300.0,\n  \"brewTime\": \"00:02:30\",\n  \"remark\": \"Perfect extraction\",\n  \"aroma\": 5,\n  \"acidity\": 4,\n  \"body\": 3,\n  \"overall\": 9\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/experiment",
              "host": ["{{baseUrl}}"],
              "path": ["api", "experiment"]
            },
            "description": "Create a new brew experiment record.\n\nRating scales:\n- Aroma: 1-5\n- Acidity: 1-5\n- Body: 1-5\n- Overall: 1-10"
          },
          "response": []
        }
      ],
      "description": "Experiment tracking endpoints"
    },
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": ["{{baseUrl}}"],
              "path": ["api", "health"]
            },
            "description": "Get API health status and architecture information."
          },
          "response": []
        },
        {
          "name": "Ping",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/health/ping",
              "host": ["{{baseUrl}}"],
              "path": ["api", "health", "ping"]
            },
            "description": "Simple ping endpoint to verify API is running."
          },
          "response": []
        },
        {
          "name": "Error Test",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/health/error-test",
              "host": ["{{baseUrl}}"],
              "path": ["api", "health", "error-test"]
            },
            "description": "Test endpoint to verify error response format (returns 200 with success=false)."
          },
          "response": []
        }
      ],
      "description": "Health check and testing endpoints"
    }
  ]
}
